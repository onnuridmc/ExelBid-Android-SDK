<?xml version="1.0" encoding="utf-8"?>
<!--
  AdMob 미디에이션 검증 화면 공용 레이아웃 (배너 / 전면 / 네이티브)

  ExelBid 커스텀 이벤트가 AdMob 워터폴에서 실제로 호출되는지 확인하는 용도다.
-->
<!--
  targetSdk 35 부터 Android 15의 edge-to-edge가 강제 적용되어 콘텐츠가 상태바 뒤로 그려진다.
  앱 테마가 NoActionBar 라 별도 여백도 없으므로 fitsSystemWindows 로 시스템 바 인셋을 패딩으로 받는다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="AdMob 대시보드에 등록할 Class Name"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_class_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="#F0F0F0"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:typeface="monospace" />

        <RadioGroup
            android:id="@+id/rg_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_mediation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="실제 유닛 — 미디에이션 동작 (ExelBid 검증용)"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Google 테스트 유닛 — 미디에이션 미동작"
                android:textSize="13sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_unit_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:typeface="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_load"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="광고 로드"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_show"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="광고 표시"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_inspector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="광고 검사기"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FAFAFA"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:typeface="monospace" />

        <FrameLayout
            android:id="@+id/fl_ad_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
